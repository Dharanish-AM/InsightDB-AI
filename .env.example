# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="InsightDB AI"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production"

# Database Configuration (Application DB)
POSTGRES_USER=insightdb
POSTGRES_PASSWORD=insightdb_pass
POSTGRES_DB=insightdb_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://insightdb:insightdb_pass@localhost:5432/insightdb_dev

# Cache & State Storage
REDIS_URL=redis://localhost:6379/0

# AI Models (Optional for initial setup)
OPENAI_API_KEY=your_openai_api_key_here
